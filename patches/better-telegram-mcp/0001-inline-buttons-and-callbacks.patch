diff --git a/src/better_telegram_mcp/callbacks.py b/src/better_telegram_mcp/callbacks.py
new file mode 100644
index 0000000..ed65a54
--- /dev/null
+++ b/src/better_telegram_mcp/callbacks.py
@@ -0,0 +1,139 @@
+"""Policy and cursor state for inline-button callback queries.
+
+Two pieces of durable-ish state sit behind ``message(action='callbacks')``:
+
+* a **policy** -- who is allowed to press the bot's buttons, and what
+  ``callback_data`` is considered well-formed. A callback query is a message
+  from an arbitrary Telegram user, so the sender allowlist is the security
+  boundary; the data pattern is a second belt on data the server itself
+  minted.
+* a **cursor** -- the highest ``update_id`` already handed to the caller.
+  Keeping it server-side means a repeated ``callbacks`` call cannot replay a
+  press the agent already acted on.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from loguru import logger
+
+
+@dataclass(frozen=True)
+class CallbackPolicy:
+    """Who may press buttons, and what their payload must look like."""
+
+    allowed_from_ids: frozenset[int] = frozenset()
+    data_pattern: re.Pattern[str] | None = None
+
+    @classmethod
+    def from_settings(cls, settings: Any) -> CallbackPolicy:
+        return cls(
+            allowed_from_ids=_parse_sender_ids(
+                getattr(settings, "allowed_callback_senders", None)
+            ),
+            data_pattern=_compile_pattern(
+                getattr(settings, "callback_data_pattern", None)
+            ),
+        )
+
+    def rejection_reason(self, *, from_id: Any, data: Any) -> str | None:
+        """Return why this press must be ignored, or ``None`` to accept it."""
+        if not isinstance(from_id, int):
+            return "unknown_sender"
+        if self.allowed_from_ids and from_id not in self.allowed_from_ids:
+            return "sender_not_allowed"
+        if not isinstance(data, str) or not data:
+            return "missing_data"
+        if self.data_pattern is not None and not self.data_pattern.fullmatch(data):
+            return "data_pattern_mismatch"
+        return None
+
+
+def _parse_sender_ids(raw: str | None) -> frozenset[int]:
+    if not raw:
+        return frozenset()
+    ids: set[int] = set()
+    for chunk in str(raw).replace(";", ",").split(","):
+        chunk = chunk.strip()
+        if not chunk:
+            continue
+        try:
+            ids.add(int(chunk))
+        except ValueError:
+            logger.warning(
+                "Ignoring non-numeric entry in TELEGRAM_ALLOWED_CALLBACK_SENDERS: {}",
+                chunk,
+            )
+    return frozenset(ids)
+
+
+def _compile_pattern(raw: str | None) -> re.Pattern[str] | None:
+    if not raw or not str(raw).strip():
+        return None
+    try:
+        return re.compile(str(raw))
+    except re.error as e:
+        logger.warning(
+            "Ignoring invalid TELEGRAM_CALLBACK_DATA_PATTERN ({}): {}", raw, e
+        )
+        return None
+
+
+class CursorStore:
+    """Last consumed ``update_id`` per bot identity.
+
+    Backed by a small JSON file so the cursor survives a server restart; falls
+    back to memory when the path is unusable (read-only volume, CF workers),
+    which still prevents replays inside one process lifetime.
+    """
+
+    def __init__(self, path: Path | None = None):
+        self._path = Path(path) if path else None
+        self._memory: dict[str, int] = {}
+
+    def get(self, scope: str) -> int | None:
+        value = self._read().get(scope)
+        return value if isinstance(value, int) else None
+
+    def set(self, scope: str, update_id: int) -> None:
+        data = self._read()
+        data[scope] = int(update_id)
+        self._memory = data
+        if self._path is None:
+            return
+        try:
+            self._path.parent.mkdir(parents=True, exist_ok=True)
+            tmp = self._path.with_suffix(f"{self._path.suffix}.tmp")
+            tmp.write_text(json.dumps(data), encoding="utf-8")
+            tmp.replace(self._path)
+        except OSError as e:
+            logger.warning("Callback cursor not persisted to {}: {}", self._path, e)
+
+    def _read(self) -> dict[str, int]:
+        if self._path is None:
+            return dict(self._memory)
+        try:
+            raw = json.loads(self._path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            return dict(self._memory)
+        if not isinstance(raw, dict):
+            return dict(self._memory)
+        return {k: v for k, v in raw.items() if isinstance(v, int)}
+
+
+@dataclass
+class CallbackContext:
+    """Everything ``message(action='callbacks')`` needs beyond the backend."""
+
+    policy: CallbackPolicy = field(default_factory=CallbackPolicy)
+    cursor: CursorStore = field(default_factory=CursorStore)
+
+    @classmethod
+    def default(cls) -> CallbackContext:
+        """In-memory, allow-everyone context (tests and unconfigured servers)."""
+        return cls()
