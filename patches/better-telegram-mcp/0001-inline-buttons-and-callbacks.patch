+from __future__ import annotations
+
+import httpx
+import pytest
+
+from better_telegram_mcp.backends.base import ModeError
+from better_telegram_mcp.backends.bot_backend import BotBackend
+
+TOKEN = "123456:AAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
+
+BUTTONS = [
+    [
+        {"text": "✅ Да", "data": "DEC-12:yes"},
+        {"text": "✖️ Нет", "data": "DEC-12:no"},
+    ]
+]
+
+
+def _recording_bot(result=True):
+    """BotBackend whose HTTP calls are captured as (method, payload) pairs."""
+    calls: list[tuple[str, dict]] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        import json
+
+        calls.append(
+            (request.url.path.rsplit("/", 1)[-1], json.loads(request.content or b"{}"))
+        )
+        return httpx.Response(200, json={"ok": True, "result": result})
+
+    bot = BotBackend(TOKEN)
+    bot._client = httpx.AsyncClient(
+        transport=httpx.MockTransport(handler), base_url=bot._base_url
+    )
+    return bot, calls
+
+
+async def test_send_message_attaches_inline_keyboard():
+    bot, calls = _recording_bot({"message_id": 4711})
+    await bot.send_message(375465077, "DEC-12 — перенести?", buttons=BUTTONS)
+
+    method, payload = calls[0]
+    assert method == "sendMessage"
+    assert payload["reply_markup"] == {
+        "inline_keyboard": [
+            [
+                {"text": "✅ Да", "callback_data": "DEC-12:yes"},
+                {"text": "✖️ Нет", "callback_data": "DEC-12:no"},
+            ]
+        ]
+    }
+
+
+async def test_send_message_without_buttons_omits_reply_markup():
+    bot, calls = _recording_bot({"message_id": 1})
+    await bot.send_message(1, "plain")
+    assert "reply_markup" not in calls[0][1]
+
+
+async def test_send_message_rejects_bad_buttons_before_calling_telegram():
+    bot, calls = _recording_bot()
+    with pytest.raises(ValueError, match="callback_data"):
+        await bot.send_message(1, "hi", buttons=[[{"text": "Yes", "data": "x" * 65}]])
+    assert calls == []
+
+
+async def test_edit_message_can_replace_and_strip_buttons():
+    bot, calls = _recording_bot({"message_id": 4711})
+    await bot.edit_message(1, 4711, "done — ✅ да", buttons=[])
+    method, payload = calls[0]
+    assert method == "editMessageText"
+    assert payload["reply_markup"] == {"inline_keyboard": []}
+
+
+async def test_get_updates_passes_offset_and_filter():
+    update = {"update_id": 7, "callback_query": {"id": "q", "data": "DEC-1:yes"}}
+    bot, calls = _recording_bot([update])
+    result = await bot.get_updates(
+        offset=7, limit=50, allowed_updates=["callback_query"]
+    )
+
+    method, payload = calls[0]
+    assert method == "getUpdates"
+    assert payload == {
+        "offset": 7,
+        "limit": 50,
+        "timeout": 0,
+        "allowed_updates": ["callback_query"],
+    }
+    assert result == [update]
+
+
+async def test_get_updates_tolerates_non_list_result():
+    bot, _ = _recording_bot(True)
+    assert await bot.get_updates() == []
+
+
+async def test_answer_callback_query():
+    bot, calls = _recording_bot(True)
+    assert await bot.answer_callback_query("q-1", text="Принято") is True
+    method, payload = calls[0]
+    assert method == "answerCallbackQuery"
+    assert payload == {"callback_query_id": "q-1", "text": "Принято"}
+
+
+async def test_answer_callback_query_with_alert():
+    bot, calls = _recording_bot(True)
+    await bot.answer_callback_query("q-1", show_alert=True)
+    assert calls[0][1]["show_alert"] is True
+
+
+async def test_set_message_reply_markup_removes_keyboard():
+    bot, calls = _recording_bot(True)
+    await bot.set_message_reply_markup(375465077, 4711)
+    method, payload = calls[0]
+    assert method == "editMessageReplyMarkup"
+    assert payload == {"chat_id": 375465077, "message_id": 4711}
+
+
+async def test_set_message_reply_markup_replaces_keyboard():
+    bot, calls = _recording_bot(True)
+    await bot.set_message_reply_markup(1, 2, buttons=BUTTONS)
+    assert calls[0][1]["reply_markup"]["inline_keyboard"][0][0] == {
+        "text": "✅ Да",
+        "callback_data": "DEC-12:yes",
+    }
+
+
+async def test_identity_key_uses_bot_id():
+    bot, _ = _recording_bot({"id": 99, "is_bot": True, "first_name": "T"})
+    assert bot.identity_key() == "bot"
+    await bot.connect()
+    assert bot.identity_key() == "bot:99"
+
+
+# --- User mode ---
+
+
+async def test_user_backend_refuses_buttons():
+    from better_telegram_mcp.backends.user_backend import UserBackend
+    from better_telegram_mcp.config import Settings
+
+    backend = UserBackend(Settings(api_id=1, api_hash="h", phone="+15550000"))
+    with pytest.raises(ModeError):
+        await backend.send_message(1, "hi", buttons=BUTTONS)
+    with pytest.raises(ModeError):
+        await backend.edit_message(1, 2, "hi", buttons=BUTTONS)
+    with pytest.raises(ModeError):
+        await backend.get_updates()
+    with pytest.raises(ModeError):
+        await backend.answer_callback_query("q")
+    with pytest.raises(ModeError):
+        await backend.set_message_reply_markup(1, 2)
