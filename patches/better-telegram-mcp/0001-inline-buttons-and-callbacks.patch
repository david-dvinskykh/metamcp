index 0000000..51b6310
--- /dev/null
+++ b/src/better_telegram_mcp/utils/keyboard.py
@@ -0,0 +1,91 @@
+"""Inline-keyboard construction for Bot API ``reply_markup``.
+
+The MCP tool layer accepts a compact button spec -- rows of
+``{"text": ..., "data": ...}`` -- and this module turns it into the
+``{"inline_keyboard": [[{"text": ..., "callback_data": ...}]]}`` payload the
+Bot API expects, rejecting anything Telegram would reject anyway (over-long
+``callback_data``, empty labels, oversized rows) before the request goes out.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+# Bot API caps callback_data at 1-64 bytes (UTF-8). Row/grid limits are not
+# documented as hard errors, but wide keyboards render badly on mobile and a
+# runaway grid is almost always a caller bug -- so both are refused here.
+MAX_CALLBACK_DATA_BYTES = 64
+MAX_BUTTONS_PER_ROW = 8
+MAX_ROWS = 100
+
+ButtonRows = list[list[dict[str, Any]]]
+
+
+def normalize_buttons(buttons: Any) -> ButtonRows:
+    """Coerce the caller's button spec into a list of rows.
+
+    Accepts the canonical rows-of-buttons form and, as a convenience, a flat
+    list of buttons (treated as a single row).
+    """
+    if not isinstance(buttons, list):
+        raise ValueError(
+            "buttons must be a list of rows, e.g. "
+            '[[{"text": "Yes", "data": "DEC-12:yes"}]]'
+        )
+    if buttons and all(isinstance(b, dict) for b in buttons):
+        return [list(buttons)]
+    rows: ButtonRows = []
+    for row in buttons:
+        if not isinstance(row, list):
+            raise ValueError(
+                "buttons must be a list of rows (each row a list of buttons), "
+                'e.g. [[{"text": "Yes", "data": "DEC-12:yes"}]]'
+            )
+        rows.append(list(row))
+    return rows
+
+
+def _build_button(button: Any) -> dict[str, str]:
+    if not isinstance(button, dict):
+        raise ValueError('each button must be an object with "text" and "data"')
+
+    text = button.get("text")
+    if not isinstance(text, str) or not text.strip():
+        raise ValueError('each button needs a non-empty "text"')
+
+    data = button.get("data", button.get("callback_data"))
+    if not isinstance(data, str) or not data:
+        raise ValueError(
+            f'button "{text}" needs a non-empty "data" (callback_data) string'
+        )
+    size = len(data.encode("utf-8"))
+    if size > MAX_CALLBACK_DATA_BYTES:
+        raise ValueError(
+            f'button "{text}" has callback_data of {size} bytes; '
+            f"Telegram allows at most {MAX_CALLBACK_DATA_BYTES}"
+        )
+    return {"text": text, "callback_data": data}
+
+
+def build_inline_keyboard(buttons: Any | None) -> dict[str, Any] | None:
+    """Build a ``reply_markup`` payload from a button spec.
+
+    ``None`` yields ``None`` (send/edit without touching the keyboard); an
+    empty list yields an empty ``inline_keyboard``, which Telegram reads as
+    "remove the buttons".
+    """
+    if buttons is None:
+        return None
+
+    rows = normalize_buttons(buttons)
+    if len(rows) > MAX_ROWS:
+        raise ValueError(f"too many button rows ({len(rows)}); max is {MAX_ROWS}")
+
+    keyboard: list[list[dict[str, str]]] = []
+    for row in rows:
+        if len(row) > MAX_BUTTONS_PER_ROW:
+            raise ValueError(
+                f"too many buttons in a row ({len(row)}); max is {MAX_BUTTONS_PER_ROW}"
+            )
+        keyboard.append([_build_button(b) for b in row])
+    return {"inline_keyboard": keyboard}
