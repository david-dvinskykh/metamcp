+++ b/tests/test_callbacks.py
@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+import re
+
+from better_telegram_mcp.callbacks import (
+    CallbackContext,
+    CallbackPolicy,
+    CursorStore,
+)
+from better_telegram_mcp.config import Settings
+
+DEC = re.compile(r"^DEC-\d+:(yes|no|later)$")
+
+
+# --- Policy ---
+
+
+def test_empty_allowlist_accepts_any_sender():
+    policy = CallbackPolicy()
+    assert policy.rejection_reason(from_id=1, data="anything") is None
+
+
+def test_allowlist_rejects_other_senders():
+    policy = CallbackPolicy(allowed_from_ids=frozenset({375465077}))
+    assert policy.rejection_reason(from_id=375465077, data="DEC-1:yes") is None
+    assert policy.rejection_reason(from_id=42, data="DEC-1:yes") == "sender_not_allowed"
+
+
+def test_unknown_sender_rejected():
+    assert CallbackPolicy().rejection_reason(from_id=None, data="d") == "unknown_sender"
+
+
+def test_missing_data_rejected():
+    assert CallbackPolicy().rejection_reason(from_id=1, data=None) == "missing_data"
+    assert CallbackPolicy().rejection_reason(from_id=1, data="") == "missing_data"
+
+
+def test_data_pattern_enforced():
+    policy = CallbackPolicy(data_pattern=DEC)
+    assert policy.rejection_reason(from_id=1, data="DEC-12:yes") is None
+    assert (
+        policy.rejection_reason(from_id=1, data="DEC-12:maybe")
+        == "data_pattern_mismatch"
+    )
+    assert (
+        policy.rejection_reason(from_id=1, data="x DEC-12:yes")
+        == "data_pattern_mismatch"
+    )
+
+
+def test_from_settings_parses_env_config(monkeypatch):
+    monkeypatch.setenv("TELEGRAM_ALLOWED_CALLBACK_SENDERS", " 375465077, 42 ")
+    monkeypatch.setenv("TELEGRAM_CALLBACK_DATA_PATTERN", r"^DEC-\d+:(yes|no|later)$")
+    policy = CallbackPolicy.from_settings(Settings())
+    assert policy.allowed_from_ids == frozenset({375465077, 42})
+    assert policy.rejection_reason(from_id=42, data="DEC-3:later") is None
+    assert (
+        policy.rejection_reason(from_id=7, data="DEC-3:later") == "sender_not_allowed"
+    )
+
+
+def test_from_settings_without_config_is_permissive(monkeypatch):
+    monkeypatch.delenv("TELEGRAM_ALLOWED_CALLBACK_SENDERS", raising=False)
+    monkeypatch.delenv("TELEGRAM_CALLBACK_DATA_PATTERN", raising=False)
+    policy = CallbackPolicy.from_settings(Settings())
+    assert policy.allowed_from_ids == frozenset()
+    assert policy.data_pattern is None
+
+
+def test_from_settings_skips_garbage_entries(monkeypatch):
+    monkeypatch.setenv("TELEGRAM_ALLOWED_CALLBACK_SENDERS", "12; not-an-id ,34")
+    monkeypatch.setenv("TELEGRAM_CALLBACK_DATA_PATTERN", "([unclosed")
+    policy = CallbackPolicy.from_settings(Settings())
+    assert policy.allowed_from_ids == frozenset({12, 34})
+    assert policy.data_pattern is None
+
+
+# --- Cursor store ---
+
+
+def test_cursor_roundtrip_on_disk(tmp_path):
+    path = tmp_path / "state" / "callback_cursor.json"
+    store = CursorStore(path)
+    assert store.get("bot:1") is None
+
+    store.set("bot:1", 500)
+    assert store.get("bot:1") == 500
+    # A fresh instance reads the same file: the cursor survives a restart.
+    assert CursorStore(path).get("bot:1") == 500
+
+
+def test_cursor_is_per_scope(tmp_path):
+    store = CursorStore(tmp_path / "cursor.json")
+    store.set("bot:1", 10)
+    store.set("bot:2", 20)
+    assert store.get("bot:1") == 10
+    assert store.get("bot:2") == 20
+
+
+def test_cursor_falls_back_to_memory_without_path():
+    store = CursorStore()
+    store.set("bot:1", 7)
+    assert store.get("bot:1") == 7
+
+
+def test_cursor_survives_corrupt_file(tmp_path):
+    path = tmp_path / "cursor.json"
+    path.write_text("not json", encoding="utf-8")
+    store = CursorStore(path)
+    assert store.get("bot:1") is None
+    store.set("bot:1", 3)
+    assert store.get("bot:1") == 3
+
+
+def test_cursor_ignores_non_int_values(tmp_path):
+    path = tmp_path / "cursor.json"
+    path.write_text('{"bot:1": "nope"}', encoding="utf-8")
+    assert CursorStore(path).get("bot:1") is None
+
+
+def test_cursor_ignores_non_dict_file(tmp_path):
+    path = tmp_path / "cursor.json"
+    path.write_text("[1, 2]", encoding="utf-8")
+    assert CursorStore(path).get("bot:1") is None
+
+
+def test_cursor_keeps_working_when_path_unwritable(tmp_path):
+    # A file where a directory is expected makes every write fail.
+    blocked = tmp_path / "file.txt"
+    blocked.write_text("x", encoding="utf-8")
+    store = CursorStore(blocked / "nested" / "cursor.json")
+    store.set("bot:1", 9)
+    assert store.get("bot:1") == 9
+
+
+def test_default_context_is_permissive_and_in_memory():
+    ctx = CallbackContext.default()
+    assert ctx.policy.rejection_reason(from_id=1, data="d") is None
+    assert ctx.cursor.get("bot:1") is None
