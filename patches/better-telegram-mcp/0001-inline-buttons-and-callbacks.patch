diff --git a/tests/test_tools/test_messages_callbacks.py b/tests/test_tools/test_messages_callbacks.py
new file mode 100644
index 0000000..089e072
--- /dev/null
+++ b/tests/test_tools/test_messages_callbacks.py
@@ -0,0 +1,278 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from better_telegram_mcp.callbacks import CallbackContext, CallbackPolicy, CursorStore
+from better_telegram_mcp.tools.messages import MessagesArgs, handle_messages
+
+BUTTONS = [
+    [
+        {"text": "✅ Да", "data": "DEC-12:yes"},
+        {"text": "✖️ Нет", "data": "DEC-12:no"},
+        {"text": "🕓 Потом", "data": "DEC-12:later"},
+    ]
+]
+
+OWNER = 375465077
+
+
+def _update(
+    update_id: int,
+    *,
+    data: str = "DEC-12:yes",
+    from_id: int = OWNER,
+    message_id: int = 4711,
+    date: int | None = 1787059391,
+) -> dict[str, Any]:
+    message: dict[str, Any] = {"message_id": message_id, "chat": {"id": from_id}}
+    if date is not None:
+        message["date"] = date
+    return {
+        "update_id": update_id,
+        "callback_query": {
+            "id": f"cq-{update_id}",
+            "data": data,
+            "from": {"id": from_id},
+            "message": message,
+        },
+    }
+
+
+def _ctx(**policy_kwargs: Any) -> CallbackContext:
+    return CallbackContext(
+        policy=CallbackPolicy(**policy_kwargs), cursor=CursorStore(None)
+    )
+
+
+# --- send/edit with buttons ---
+
+
+@pytest.mark.asyncio
+async def test_send_forwards_buttons(mock_backend):
+    await handle_messages(
+        mock_backend,
+        MessagesArgs(action="send", chat_id=OWNER, text="DEC-12?", buttons=BUTTONS),
+    )
+    mock_backend.send_message.assert_awaited_once_with(
+        OWNER, "DEC-12?", reply_to=None, parse_mode=None, buttons=BUTTONS
+    )
+
+
+@pytest.mark.asyncio
+async def test_send_reports_invalid_buttons_as_error(mock_backend):
+    mock_backend.send_message.side_effect = ValueError("callback_data too long")
+    result = await handle_messages(
+        mock_backend,
+        MessagesArgs(
+            action="send",
+            chat_id=OWNER,
+            text="x",
+            buttons=[[{"text": "Yes", "data": "x" * 65}]],
+        ),
+    )
+    assert "callback_data too long" in result["error"]
+
+
+@pytest.mark.asyncio
+async def test_edit_can_strip_buttons(mock_backend):
+    await handle_messages(
+        mock_backend,
+        MessagesArgs(
+            action="edit", chat_id=OWNER, message_id=4711, text="— ✅ да", buttons=[]
+        ),
+    )
+    mock_backend.edit_message.assert_awaited_once_with(
+        OWNER, 4711, "— ✅ да", parse_mode=None, buttons=[]
+    )
+
+
+# --- callbacks ---
+
+
+@pytest.mark.asyncio
+async def test_callbacks_returns_presses_and_acks_them(mock_backend):
+    mock_backend.get_updates.return_value = [_update(101)]
+
+    result = await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks", ack_text="Принято"), _ctx()
+    )
+
+    assert result["count"] == 1
+    press = result["callbacks"][0]
+    assert press["update_id"] == 101
+    assert press["data"] == "DEC-12:yes"
+    assert press["from_id"] == OWNER
+    assert press["message_id"] == 4711
+    assert press["chat_id"] == OWNER
+    assert press["callback_query_id"] == "cq-101"
+    assert press["date"] == "2026-08-18T13:23:11Z"
+    assert press["answered"] is True
+    mock_backend.answer_callback_query.assert_awaited_once_with(
+        "cq-101", text="Принято"
+    )
+
+
+@pytest.mark.asyncio
+async def test_callbacks_uses_callback_query_filter_and_no_offset_when_fresh(
+    mock_backend,
+):
+    mock_backend.get_updates.return_value = []
+    await handle_messages(mock_backend, MessagesArgs(action="callbacks"), _ctx())
+    mock_backend.get_updates.assert_awaited_once_with(
+        offset=None, limit=20, allowed_updates=["callback_query"], timeout=0
+    )
+
+
+@pytest.mark.asyncio
+async def test_callbacks_advances_cursor_so_a_second_call_cannot_replay(mock_backend):
+    ctx = _ctx()
+    mock_backend.get_updates.return_value = [_update(101), _update(102)]
+    first = await handle_messages(mock_backend, MessagesArgs(action="callbacks"), ctx)
+    assert first["count"] == 2
+    assert first["cursor"] == 102
+
+    mock_backend.get_updates.reset_mock()
+    mock_backend.get_updates.return_value = []
+    second = await handle_messages(mock_backend, MessagesArgs(action="callbacks"), ctx)
+    assert second["count"] == 0
+    # offset = last consumed + 1, so Telegram never hands the press back.
+    mock_backend.get_updates.assert_awaited_once_with(
+        offset=103, limit=20, allowed_updates=["callback_query"], timeout=0
+    )
+
+
+@pytest.mark.asyncio
+async def test_explicit_since_id_overrides_stored_cursor(mock_backend):
+    ctx = _ctx()
+    ctx.cursor.set("bot", 500)
+    mock_backend.get_updates.return_value = []
+
+    await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks", since_id=100), ctx
+    )
+    mock_backend.get_updates.assert_awaited_once_with(
+        offset=101, limit=20, allowed_updates=["callback_query"], timeout=0
+    )
+
+
+@pytest.mark.asyncio
+async def test_limit_is_clamped_to_bot_api_maximum(mock_backend):
+    mock_backend.get_updates.return_value = []
+    await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks", limit=1000), _ctx()
+    )
+    assert mock_backend.get_updates.await_args.kwargs["limit"] == 100
+
+
+@pytest.mark.asyncio
+async def test_presses_from_other_users_are_ignored_and_not_acked(mock_backend):
+    mock_backend.get_updates.return_value = [
+        _update(101, from_id=999),
+        _update(102),
+    ]
+    result = await handle_messages(
+        mock_backend,
+        MessagesArgs(action="callbacks"),
+        _ctx(allowed_from_ids=frozenset({OWNER})),
+    )
+
+    assert result["count"] == 1
+    assert result["callbacks"][0]["update_id"] == 102
+    assert result["ignored"] == [
+        {"update_id": 101, "from_id": 999, "reason": "sender_not_allowed"}
+    ]
+    mock_backend.answer_callback_query.assert_awaited_once_with("cq-102", text=None)
+    # The intruder's update is still consumed, so it cannot come back.
+    assert result["cursor"] == 102
+
+
+@pytest.mark.asyncio
+async def test_malformed_callback_data_is_ignored(mock_backend):
+    import re
+
+    mock_backend.get_updates.return_value = [_update(101, data="drop table")]
+    result = await handle_messages(
+        mock_backend,
+        MessagesArgs(action="callbacks"),
+        _ctx(data_pattern=re.compile(r"^DEC-\d+:(yes|no|later)$")),
+    )
+    assert result["count"] == 0
+    assert result["ignored"][0]["reason"] == "data_pattern_mismatch"
+    mock_backend.answer_callback_query.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_non_callback_updates_are_skipped_but_confirmed(mock_backend):
+    mock_backend.get_updates.return_value = [
+        {"update_id": 90, "message": {"message_id": 1, "text": "hi"}},
+        "garbage",
+        _update(91),
+    ]
+    result = await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks"), _ctx()
+    )
+    assert result["count"] == 1
+    assert result["cursor"] == 91
+
+
+@pytest.mark.asyncio
+async def test_strip_buttons_removes_the_keyboard(mock_backend):
+    mock_backend.get_updates.return_value = [_update(101)]
+    result = await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks", strip_buttons=True), _ctx()
+    )
+    assert result["callbacks"][0]["buttons_removed"] is True
+    mock_backend.set_message_reply_markup.assert_awaited_once_with(
+        OWNER, 4711, buttons=None
+    )
+
+
+@pytest.mark.asyncio
+async def test_strip_buttons_failure_does_not_drop_the_press(mock_backend):
+    mock_backend.get_updates.return_value = [_update(101)]
+    mock_backend.set_message_reply_markup.side_effect = RuntimeError("message gone")
+    result = await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks", strip_buttons=True), _ctx()
+    )
+    assert result["count"] == 1
+    assert result["callbacks"][0]["buttons_removed"] is False
+
+
+@pytest.mark.asyncio
+async def test_failed_ack_is_reported_but_press_is_kept(mock_backend):
+    mock_backend.get_updates.return_value = [_update(101)]
+    mock_backend.answer_callback_query.side_effect = RuntimeError("query is too old")
+    result = await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks"), _ctx()
+    )
+    assert result["count"] == 1
+    assert result["callbacks"][0]["answered"] is False
+
+
+@pytest.mark.asyncio
+async def test_press_without_message_date_has_null_date(mock_backend):
+    mock_backend.get_updates.return_value = [_update(101, date=None)]
+    result = await handle_messages(
+        mock_backend, MessagesArgs(action="callbacks"), _ctx()
+    )
+    assert result["callbacks"][0]["date"] is None
+
+
+@pytest.mark.asyncio
+async def test_callbacks_without_context_uses_permissive_default(mock_backend):
+    mock_backend.get_updates.return_value = [_update(101)]
+    result = await handle_messages(mock_backend, MessagesArgs(action="callbacks"))
+    assert result["count"] == 1
+
+
+@pytest.mark.asyncio
+async def test_callbacks_in_user_mode_reports_mode_error(mock_user_backend):
+    from better_telegram_mcp.backends.base import ModeError
+
+    mock_user_backend.get_updates.side_effect = ModeError("bot")
+    result = await handle_messages(
+        mock_user_backend, MessagesArgs(action="callbacks"), _ctx()
+    )
+    assert "bot mode" in result["error"]
diff --git a/tests/test_utils/test_keyboard.py b/tests/test_utils/test_keyboard.py
new file mode 100644
index 0000000..78274f1
--- /dev/null
+++ b/tests/test_utils/test_keyboard.py
@@ -0,0 +1,97 @@
+from __future__ import annotations
+
+import pytest
+
+from better_telegram_mcp.utils.keyboard import (
+    MAX_BUTTONS_PER_ROW,
+    MAX_ROWS,
+    build_inline_keyboard,
+)
+
+
+def test_none_yields_no_markup():
+    assert build_inline_keyboard(None) is None
+
+
+def test_empty_list_yields_empty_keyboard():
+    # Telegram reads an empty inline_keyboard as "remove the buttons".
+    assert build_inline_keyboard([]) == {"inline_keyboard": []}
+
+
+def test_rows_are_mapped_to_callback_data():
+    markup = build_inline_keyboard(
+        [
+            [
+                {"text": "✅ Да", "data": "DEC-12:yes"},
+                {"text": "✖️ Нет", "data": "DEC-12:no"},
+            ],
+            [{"text": "🕓 Потом", "data": "DEC-12:later"}],
+        ]
+    )
+    assert markup == {
+        "inline_keyboard": [
+            [
+                {"text": "✅ Да", "callback_data": "DEC-12:yes"},
+                {"text": "✖️ Нет", "callback_data": "DEC-12:no"},
+            ],
+            [{"text": "🕓 Потом", "callback_data": "DEC-12:later"}],
+        ]
+    }
+
+
+def test_flat_list_is_treated_as_single_row():
+    markup = build_inline_keyboard([{"text": "Yes", "data": "d"}])
+    assert markup == {"inline_keyboard": [[{"text": "Yes", "callback_data": "d"}]]}
+
+
+def test_callback_data_alias_accepted():
+    markup = build_inline_keyboard([[{"text": "Yes", "callback_data": "d"}]])
+    assert markup == {"inline_keyboard": [[{"text": "Yes", "callback_data": "d"}]]}
+
+
+def test_rejects_non_list():
+    with pytest.raises(ValueError, match="list of rows"):
+        build_inline_keyboard({"text": "Yes", "data": "d"})
+
+
+def test_rejects_row_that_is_not_a_list():
+    with pytest.raises(ValueError, match="list of rows"):
+        build_inline_keyboard([[{"text": "a", "data": "b"}], "nope"])
+
+
+def test_rejects_non_dict_button():
+    with pytest.raises(ValueError, match="object"):
+        build_inline_keyboard([["Yes"]])
+
+
+def test_rejects_empty_text():
+    with pytest.raises(ValueError, match="non-empty"):
+        build_inline_keyboard([[{"text": "  ", "data": "d"}]])
+
+
+def test_rejects_missing_data():
+    with pytest.raises(ValueError, match="callback_data"):
+        build_inline_keyboard([[{"text": "Yes"}]])
+
+
+def test_rejects_oversized_callback_data():
+    # 64 bytes is the Bot API cap; these Cyrillic chars are 2 bytes each.
+    with pytest.raises(ValueError, match="65 bytes"):
+        build_inline_keyboard([[{"text": "Yes", "data": "я" * 32 + "x"}]])
+
+
+def test_accepts_callback_data_at_the_limit():
+    markup = build_inline_keyboard([[{"text": "Yes", "data": "x" * 64}]])
+    assert markup == {"inline_keyboard": [[{"text": "Yes", "callback_data": "x" * 64}]]}
+
+
